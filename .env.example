# Full internal PostgREST root and its dedicated service JWT.
DATA_API_URL=
DATA_API_SERVICE_ROLE_KEY=
# In production this must be the exact `.internal.<ACA default domain>` suffix.
DATA_API_ALLOWED_HOST_SUFFIX=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=anbud-documents
APP_PUBLIC_ORIGIN=http://localhost:3000
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_TENANT_SUBDOMAIN=
APP_ENCRYPTION_KEY=
APP_SESSION_SECRET=
# Dedicated administrator login. Store only an encoded scrypt hash.
APP_ADMIN_ACCESS_PASSWORD_HASH=
APP_ADMIN_PRINCIPAL_ID=u_admin_replace_with_stable_random_identifier
APP_ADMIN_DISPLAY_NAME=Administrator
# Use three independently generated random values in production.
APP_GUEST_CODE_PEPPER=
APP_IDENTITY_LOOKUP_SECRET=
APP_ACTIVITY_HASH_SECRET=
# Bootstrap roles are synchronized when these users sign in with Microsoft.
# Preferred production setup: endpoint + Container App managed identity.
AZURE_COMMUNICATION_EMAIL_ENDPOINT=
AZURE_COMMUNICATION_EMAIL_SENDER=
# Local alternative. Avoid this long-lived secret in production.
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_DOCUMENT_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_QUERY_REWRITE=adaptive
DOCUMENT_ANALYSIS_VERSION=off
DOCUMENT_ANALYSIS_CONTEXT_CHARS=18000
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=120000
AZURE_DOCUMENT_INTELLIGENCE_HIGH_RESOLUTION=auto
DOCLING_INGESTION=on
DOCLING_FORMATS=pdf,docx
DOCLING_ENHANCEMENT_MODE=async
DOCLING_ASYNC_AUTO_RUN=off
DOCLING_CLI_COMMAND=docling
DOCLING_ARTIFACTS_PATH=/opt/docling-models
DOCLING_IMAGE_EXPORT_MODE=placeholder
DOCLING_TABLE_MODE=accurate
DOCLING_LARGE_PDF_TABLE_MODE=fast
DOCLING_NUM_THREADS=2
DOCLING_TIMEOUT_MS=600000
DOCLING_PDF_CHUNKING=auto
DOCLING_PDF_CHUNK_PAGES=40
DOCLING_PDF_CHUNK_THRESHOLD_PAGES=120
DOCLING_OCR=auto
DOCLING_COMPLEXITY_MIN_CHARS=60000
DOCLING_COMPLEXITY_MIN_SECTIONS=80
DOCLING_POOR_EXTRACTION_MAX_CHARS=2000
PROJECT_JOB_WORKER_TOKEN=
